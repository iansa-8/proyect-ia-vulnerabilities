# Local agent (NestJS)
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
SQLITE_PATH=data/app.sqlite

# NestJS log level — use debug/verbose to trace Propose Fix routing, context budget,
# LLM calls and agent health. 'log' shows only info/warn/error (default).
# LOG_LEVEL=debug

# Frontend (Vite) — copy relevant vars to apps/web/.env if needed
VITE_API_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# Indexer (Codebase Memory CLI — not the Graph UI MCP)
INDEXER_PROVIDER=codebase-memory
# Name on PATH or absolute path to the executable (do not hardcode machine paths in source)
CODEBASE_MEMORY_COMMAND=codebase-memory-mcp
CODEBASE_MEMORY_UI_URL=http://localhost:9749
INDEX_CONTEXT_MAX_SYMBOLS=20
INDEX_CONTEXT_MAX_FILES=10
INDEX_CONTEXT_MAX_SNIPPETS=10
# Optional: INDEX_CONTEXT_MAX_SNIPPET_CHARS=2000
# Optional: INDEX_COMMAND_TIMEOUT_MS=600000
# Optional: INDEX_QUERY_TIMEOUT_MS=60000
# Optional: CODEBASE_MEMORY_UI_PROBE_TIMEOUT_MS=1500

# Optional path sandbox (comma-separated absolute roots)
# ALLOWED_PROJECT_ROOTS=C:\Users\me\repos

# Quality provider (SonarQube Web API — token never returned to the UI)
SONAR_URL=
# Optional comma-separated origins allowed for per-project URL overrides.
# The global SONAR_URL origin is trusted automatically; add only trusted extra origins.
# SONAR_ALLOWED_ORIGINS=https://sonar.example.com
SONAR_TOKEN=
# Auth for authenticated Sonar 9.9.x APIs: basic-token (default) or bearer
# SONAR_AUTH_MODE=basic-token
# Optional: QUALITY_PAGE_SIZE=50
# Maximum complete download; exceeding it fails without a partial snapshot.
# QUALITY_DOWNLOAD_MAX_ISSUES=100000

# Local Sonar Scanner CLI (name on PATH or absolute path — no machine-specific default)
SONAR_SCANNER_COMMAND=sonar-scanner
# Explicit scanner authentication, independent of Web API auth mode.
# Use legacy-login for the current SonarQube 9.9 instance.
SONAR_SCANNER_AUTH_MODE=legacy-login
# Scanner process timeout (CommandExecutionService kills the child on Windows;
# grandchild process trees may remain — keep this high enough for real analyses)
# SONAR_SCANNER_TIMEOUT_MS=600000
# CE processing poll after scanner finishes
SONAR_ANALYSIS_POLL_INTERVAL_MS=2000
SONAR_ANALYSIS_TIMEOUT_MS=120000

# Coding agent provider — select: codex | opencode
AGENT_PROVIDER=opencode

# Codex CLI (used when AGENT_PROVIDER=codex)
CODEX_COMMAND=codex
CODEX_TIMEOUT_MS=120000
# Raw agent responses are not persisted by default.
CODEX_PERSIST_RAW_RESPONSE=false
# CODEX_RAW_RESPONSE_MAX_CHARS=20000
# Exact sanitized prompt retained with each proposal is capped for local audit.
# CODEX_PROMPT_PREVIEW_MAX_CHARS=20000

# OpenCode CLI (used when AGENT_PROVIDER=opencode)
OPENCODE_COMMAND=opencode
OPENCODE_TIMEOUT_MS=300000

# Reasoning-only LLM provider. Propose Fix uses this gateway; Apply Fix uses Agent.
LLM_PROVIDER=litellm
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=
LITELLM_MODEL=
LLM_TIMEOUT_MS=60000
AI_PROPOSE_MAX_INPUT_TOKENS=3000
AI_PROPOSE_MAX_OUTPUT_TOKENS=1200
AI_PROPOSE_BATCH_CONCURRENCY=2
# LLM_PROMPT_PREVIEW_MAX_CHARS=14000

# Fix validation (only used by quality-fix-application)
# FIX_VALIDATION_STARTUP_REQUIRED=true
# FIX_STARTUP_TIMEOUT_MS=60000
# FIX_STARTUP_READINESS_MS=5000
# FIX_VALIDATION_HEALTH_REQUIRED=false
# FIX_HEALTH_URL=http://localhost:3001/api/health
# FIX_HEALTH_POLL_INTERVAL_MS=1000
