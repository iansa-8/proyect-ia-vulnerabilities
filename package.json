{
  "name": "ai-modernization-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Modernization Platform — local MVP (Phase 1)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @amp/core -w @amp/pipeline -w @amp/providers -w @amp/validators -w @amp/scanners -w @amp/reporting -w @amp/policies",
    "build:agent": "npm run build -w @amp/local-agent",
    "build:web": "npm run build -w @amp/web",
    "dev": "concurrently -n agent,web -c blue,green \"npm run dev:agent\" \"npm run dev:web\"",
    "dev:agent": "npm run start:dev -w @amp/local-agent",
    "dev:web": "npm run dev -w @amp/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
